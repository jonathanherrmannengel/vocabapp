<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <ScrollView
        android:id="@+id/collection_or_pack_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/collection_or_pack_name_layout"
                style="@style/material_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="@string/collection_or_pack_name"
                android:textColorHint="@color/light_black"
                android:theme="@style/material_edit_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/collection_or_pack_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:textColor="@color/default_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/collection_or_pack_desc_layout"
                style="@style/material_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="@string/collection_or_pack_desc"
                android:textColorHint="@color/light_black"
                android:theme="@style/material_edit_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/collection_or_pack_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:textColor="@color/default_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/collection_or_pack_emoji_layout"
                style="@style/material_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="@string/collection_or_pack_emoji"
                android:textColorHint="@color/light_black"
                android:theme="@style/material_edit_text">

                <com.vanniktech.emoji.EmojiEditText
                    android:id="@+id/collection_or_pack_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:longClickable="false"
                    android:textAlignment="center"
                    android:textColor="@color/default_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Read-only: a tap opens the language picker -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/collection_or_pack_front_language_layout"
                style="@style/material_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="@string/language_front"
                android:textColorHint="@color/light_black"
                android:theme="@style/material_edit_text"
                app:endIconContentDescription="@string/language_choose"
                app:endIconDrawable="@drawable/outline_arrow_drop_down_24"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/collection_or_pack_front_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="@color/default_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Read-only: a tap opens the language picker -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/collection_or_pack_back_language_layout"
                style="@style/material_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="@string/language_back"
                android:textColorHint="@color/light_black"
                android:theme="@style/material_edit_text"
                app:endIconContentDescription="@string/language_choose"
                app:endIconDrawable="@drawable/outline_arrow_drop_down_24"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/collection_or_pack_back_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="@color/default_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="@string/color"
                android:textColor="@color/light_black" />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <LinearLayout
                    android:id="@+id/collection_or_pack_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
